<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- is.action -->
        <record model="ir.ui.view" id="is_action_form_view">
            <field name="name">is_action_form_view</field>
            <field name="model">is.action</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Form">
                    <header>
                        <button
                            name="vers_plan_action"
                            string="vers Plan"
                            type="object"
                            attrs="{'invisible': [('state', 'not in', ['do', 'check'])]}"
                        />
                        <button
                            name="vers_do_action"
                            string="vers Do"
                            type="object"
                            attrs="{'invisible': [('state', '!=', 'plan')]}"
                        />
                        <button
                            name="vers_check_action"
                            string="vers Check"
                            type="object"
                            attrs="{'invisible': [('state', '!=', 'do')]}"
                        />
                        <button
                            name="vers_annule_action"
                            string="vers Annulé"
                            type="object"
                            attrs="{'invisible': [('state', '==', 'annule')]}"
                        />
                        <field name="state" widget="statusbar" statusbar_visible="plan,do,check"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Archivé" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                        <field name="active" invisible="1"/>
                        <field name="readonly_all" invisible="1"/>
                        <group attrs="{'invisible': [('plan_action_id', '=', False)]}">
                            <field name="plan_action_id" readonly="1"/>
                        </group>
                        <group col="2">
                            <group string="Description de l'action">
                                <field name="title"    attrs="{'readonly': [('readonly_all','=',True)]}"/>
                                <field name="resp_id"  attrs="{'readonly': [('readonly_all','=',True)]}"/>
                                <field name="comment"  attrs="{'readonly': [('readonly_all','=',True)]}"/>
                            </group>
                            <group string="Analyse 8D simplifiée">
                                <field name="risque"             attrs="{'readonly': [('readonly_all','=',True)]}"/>
                                <field name="constat"            attrs="{'readonly': [('readonly_all','=',True)]}"/>
                                <field name="causes_retenues"    attrs="{'readonly': [('readonly_all','=',True)]}"/>
                                <field name="preuves_efficacite" attrs="{'readonly': [('readonly_all','=',True)]}"/>
                            </group>
                        </group>
                        <group col="2">
                            <group string="État d'avancement">
                                <field name="date" readonly="1"/>
                                <field name="dateplan" attrs="{'readonly': [('readonly_all','=',True)]}" required="1"/>
                                <field name="datedo" readonly="1"/>
                                <field name="datecheck" readonly="1"/>
                            </group>
                        </group>
                        <group string="Fichiers">
                            <field name="file_ids" widget="many2many_binary" attrs="{'readonly': [('readonly_all','=',True)]}"/>
                        </group>
                    </sheet>
                   <div class="oe_chatter">
                        <field name="message_follower_ids" />
                        <field name="activity_ids" />
                        <field name="message_ids" />
                    </div>
                </form>
            </field>
        </record>
        <record model="ir.ui.view" id="is_action_tree_view">
            <field name="name">is_action_tree_view</field>
            <field name="model">is.action</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="title"            optional="show"/>
                    <field name="pilot_id"         optional="hide"/>
                    <field name="resp_id"          optional="show"/>
                    <field name="risque"           optional="show"/>
                    <field name="comment"          optional="show"/>
                    <field name="constat"            optional="hide"/>
                    <field name="causes_retenues"    optional="hide"/>
                    <field name="preuves_efficacite" optional="hide"/>
                    <field name="date"             optional="hide"/>
                    <field name="dateplan"         optional="hide"/>
                    <field name="datedo"           optional="hide"/>
                    <field name="datecheck"        optional="hide"/>
                    <field name="plan_action_id"   optional="hide"/>
                    <field name="num_moule"        optional="hide"/>
                    <field name="num_dossierf"     optional="hide"/>
                    <field name="client"           optional="hide"/>
                    <field name="date_beg"         optional="hide"/>
                    <field name="date_end"         optional="hide"/>
                    <field name="create_date"      optional="hide" string="Créé le"/>
                    <field name="create_uid"       optional="hide" string="Créé par"/>
                    <field name="write_date"       optional="hide" string="Modifié le"/>
                    <field name="write_uid"        optional="hide" string="Modifié par"/>

                    <field
                        name="state" optional="show" widget="badge"
                        decoration-info="state in ['do']"
                        decoration-success="state in ['check']"
                        decoration-danger="state == 'plan' and dateplan and dateplan &lt; current_date"
                        decoration-muted="state == 'annule' or (state == 'plan' and not (dateplan and dateplan &lt; current_date))"
                    />
                    <field name="indicateur"       optional="hide"/>
                </tree>
            </field>
        </record>
        <record model="ir.ui.view" id="is_action_search">
            <field name="name">is_action_search</field>
            <field name="model">is.action</field>
            <field name="arch" type="xml">
                <search>
                    <field name="title"/>
                    <field name="resp_id"/>
                    <field name="state"/>
                    <field name="risque"/>
                    <field name="comment"/>
                    <field name="plan_action_id"/>
                    <field name="pilot_id"/>
                    <field name="num_moule"/>
                    <field name="num_dossierf"/>
                    <field name="client"/>
                </search>
            </field>
        </record>
        <record model="ir.ui.view" id="is_action_graph_view">
            <field name="name">is_action_graph_view</field>
            <field name="model">is.action</field>
            <field name="arch" type="xml">
                <graph string="Actions" type="bar">
                    <field name="resp_id" type="row"/>
                </graph>
            </field>
        </record>
        <record model="ir.ui.view" id="is_action_pivot_view">
            <field name="name">is_action_pivot_view</field>
            <field name="model">is.action</field>
            <field name="arch" type="xml">
                <pivot string="Actions">
                    <field name="state" type="col"/>
                    <field name="resp_id" type="row"/>
                </pivot>
            </field>
        </record>
        <record model="ir.actions.act_window" id="is_action_action">
            <field name="name">Action</field>
            <field name="res_model">is.action</field>
            <field name="view_mode">tree,form,graph,pivot</field>
            <field name="context">{}
            </field>
        </record>



        <!-- is.plan.action -->
        <record model="ir.ui.view" id="is_plan_action_form_view">
            <field name="name">is_plan_action_form_view</field>
            <field name="model">is.plan.action</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Form">
                    <header>
                        <button
                            name="vers_actif_action"
                            string="vers Actif"
                            type="object"
                            attrs="{'invisible': [('state', '!=', 'solde')]}"
                        />
                        <button
                            name="vers_solde_action"
                            string="vers Soldé"
                            type="object"
                            attrs="{'invisible': [('state', '==', 'solde')]}"
                        />
                        <button
                            name="vers_annule_action"
                            string="vers Annulé"
                            type="object"
                            attrs="{'invisible': [('state', '==', 'annule')]}"
                        />
                        <field name="state" widget="statusbar" statusbar_visible="actif,solde"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_actions" type="object" class="oe_stat_button" icon="fa-tasks">
                                <field name="nb_actions" widget="statinfo" string="Actions"/>
                            </button>
                        </div>
                        <widget name="web_ribbon" title="Archivé" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                        <field name="active" invisible="1"/>
                        <field name="readonly_all" invisible="1"/>
                        <group>
                            <group>
                                <field name="num_int"  readonly="1" string="Numéro du plan d'action"/>
                                <field name="date_beg" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group string="Description du plan d'action">
                                <field name="title"       attrs="{'readonly': [('readonly_all','=',True)]}"/>
                                <field name="pilot_id"    attrs="{'readonly': [('readonly_all','=',True)]}"/>
                                <field name="group_id"    attrs="{'readonly': [('readonly_all','=',True)]}"/>
                                <field name="date_end"    attrs="{'readonly': [('readonly_all','=',True)]}"/>
                                <field name="obj"         attrs="{'readonly': [('readonly_all','=',True)]}"/>
                            </group>
                            <group string="Précision sur le périmètre">
                                <field name="processus_id" attrs="{'readonly': [('readonly_all','=',True)]}"/>
                                <field name="client_id"    attrs="{'readonly': [('readonly_all','=',True)]}"/>
                                <field name="moule_id"     attrs="{'readonly': [('readonly_all','=',True)]}"/>
                                <field name="dossierf_id"  attrs="{'readonly': [('readonly_all','=',True)]}"/>
                                <field name="designation"/>
                            </group>
                        </group>
                        <group string="Liste des actions">
                            <field name="is_action_ids" nolabel="1" colspan="2">
                                <tree>
                                    <button name="open_action_form" type="object" icon="fa-search" title="Ouvrir la fiche complète"/>
                                    <field name="title"            optional="show"/>
                                    <field name="pilot_id"         optional="hide"/>
                                    <field name="resp_id"          optional="show"/>
                                    <field name="risque"           optional="show"/>
                                    <field name="comment"          optional="show"/>
                                    <field name="constat"            optional="hide"/>
                                    <field name="causes_retenues"    optional="hide"/>
                                    <field name="preuves_efficacite" optional="hide"/>
                                    <field name="date"             optional="show"/>
                                    <field name="dateplan"         optional="show"/>
                                    <field name="datedo"           optional="show"/>
                                    <field name="datecheck"        optional="hide"/>
                                    <field name="plan_action_id"   optional="hide"/>
                                    <field name="num_moule"        optional="hide"/>
                                    <field name="num_dossierf"     optional="hide"/>
                                    <field name="client"           optional="hide"/>
                                    <field name="date_beg"         optional="hide"/>
                                    <field name="date_end"         optional="hide"/>
                                    <field name="create_date"      optional="hide" string="Créé le"/>
                                    <field name="create_uid"       optional="hide" string="Créé par"/>
                                    <field name="write_date"       optional="hide" string="Modifié le"/>
                                    <field name="write_uid"        optional="hide" string="Modifié par"/>
                                    <field
                                        name="state" optional="show" widget="badge"
                                        decoration-info="state in ['do']"
                                        decoration-success="state in ['check']"
                                        decoration-danger="state == 'plan' and dateplan and dateplan &lt; current_date"
                                        decoration-muted="state == 'annule' or (state == 'plan' and not (dateplan and dateplan &lt; current_date))"
                                    />
                                    <field name="indicateur"       optional="hide"/>
                                </tree>
                            </field>
                        </group>
                        <group string="Pièces jointes">
                            <field name="piece_jointe_ids"   widget="many2many_binary" attrs="{'readonly': [('readonly_all','=',True)]}"/>
                        </group>
                    </sheet>
                   <div class="oe_chatter">
                        <field name="message_follower_ids" />
                        <field name="activity_ids" />
                        <field name="message_ids" />
                    </div>
                </form>
            </field>
        </record>
        <record model="ir.ui.view" id="is_plan_action_tree_view">
            <field name="name">is_plan_action_tree_view</field>
            <field name="model">is.plan.action</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="num_int"          optional="show"/>
                    <field name="title"            optional="show"/>
                    <field name="processus_id"     optional="show" widget="many2one_clickable"/>
                    <field name="client_id"        optional="show" widget="many2one_clickable"/>
                    <field name="moule_id"         optional="show" widget="many2one_clickable"/>
                    <field name="dossierf_id"      optional="show" widget="many2one_clickable"/>
                    <field name="designation"      optional="show"/>
                    <field name="pilot_id"         optional="show" widget="many2one_clickable"/>
                    <field name="group_id"         optional="show" widget="many2one_clickable"/>
                    <field name="obj"              optional="show"/>
                    <field name="date_beg"         optional="show"/>
                    <field name="date_end"         optional="show"/>
                    <field name="create_date"      optional="hide" string="Créé le"/>
                    <field name="create_uid"       optional="hide" string="Créé par"/>
                    <field name="write_date"       optional="hide" string="Modifié le"/>
                    <field name="write_uid"        optional="hide" string="Modifié par"/>
                    <field
                        name="state" optional="show" widget="badge"
                        decoration-warning="state in ['annule']"
                        decoration-info="state in ['actif']"
                        decoration-success="state in ['solde']"
                    />
                </tree>
            </field>
        </record>
        <record model="ir.ui.view" id="is_plan_action_search">
            <field name="name">is_plan_action_search</field>
            <field name="model">is.plan.action</field>
            <field name="arch" type="xml">
                <search>
                    <field name="num_int"    />
                    <field name="title"      />
                    <field name="processus_id"/>
                    <field name="client_id"  />
                    <field name="moule_id"   />
                    <field name="dossierf_id"/>
                    <field name="designation"/>
                    <field name="pilot_id"   />
                    <field name="group_id"   />
                    <field name="obj"        />
                    <field name="date_beg"   />
                    <field name="date_end"   />
                </search>
            </field>
        </record>
        <record model="ir.ui.view" id="is_plan_action_graph_view">
            <field name="name">is_plan_action_graph_view</field>
            <field name="model">is.plan.action</field>
            <field name="arch" type="xml">
                <graph string="Plans d'action" type="bar">
                    <field name="pilot_id" type="row"/>
                </graph>
            </field>
        </record>
        <record model="ir.ui.view" id="is_plan_action_pivot_view">
            <field name="name">is_plan_action_pivot_view</field>
            <field name="model">is.plan.action</field>
            <field name="arch" type="xml">
                <pivot string="Plans d'action">
                    <field name="state" type="col"/>
                    <field name="pilot_id" type="row"/>
                </pivot>
            </field>
        </record>
        <record model="ir.actions.act_window" id="is_plan_action_action">
            <field name="name">Plan d'action</field>
            <field name="res_model">is.plan.action</field>
            <field name="view_mode">tree,form,graph,pivot</field>
            <field name="context">{}
            </field>
        </record>
    </data>
</odoo>
